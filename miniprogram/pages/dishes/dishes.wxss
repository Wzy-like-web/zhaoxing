.page {
  padding: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #2A1F1A;
  position: relative;
  padding-left: 24rpx;
}

.title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: #A0341A;
  border-radius: 4rpx;
}

.btn-add {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  padding: 14rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 2rpx 10rpx rgba(160,52,26,0.25);
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #8B7E72;
}

.dish-row {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(160,52,26,0.04);
}

.info {
  flex: 1;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2A1F1A;
  letter-spacing: 1rpx;
}

.meta {
  font-size: 24rpx;
  color: #8B7E72;
  margin-top: 8rpx;
}

.status-tag {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}

.status-tag.on_sale {
  background: #E5EDD9;
  color: #5B7C42;
}

.status-tag.off_sale {
  background: #F0EBE3;
  color: #B5A99B;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.btn-mini {
  padding: 10rpx 22rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background: #FBF1E2;
  color: #5C4D40;
  text-align: center;
}

.btn-mini.danger {
  color: #A0341A;
  background: #fff;
  border: 1rpx solid rgba(160,52,26,0.3);
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(42,31,26,0.65);
}

.form {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FAF6EE;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx;
  max-height: 92vh;
  overflow-y: auto;
}

.form::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 6rpx;
  background: #E8DCCB;
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 28rpx;
  letter-spacing: 4rpx;
}

.input {
  background: #fff;
  border: 2rpx solid #E8DCCB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  display: block;
  width: 100%;
}

.input.small {
  flex: 1;
  margin-bottom: 0;
  width: auto;
}

.input.narrow {
  flex: 0 0 160rpx;
  width: 160rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 500;
  margin: 16rpx 0 12rpx;
  color: #5C4D40;
  letter-spacing: 2rpx;
}

.addon-list {
  background: #FBF1E2;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  min-height: 80rpx;
}

.addon-empty {
  font-size: 24rpx;
  color: #B5A99B;
  text-align: center;
  padding: 16rpx;
}

.addon-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #E8DCCB;
  font-size: 26rpx;
}

.addon-item:last-child {
  border-bottom: none;
}

.a-name {
  flex: 1;
  color: #2A1F1A;
}

.a-price {
  color: #C28952;
  font-weight: 500;
}

.a-del {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #E8DCCB;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8B7E72;
}

.addon-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.btn-add-addon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 10rpx rgba(160,52,26,0.25);
}

.form-actions {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  text-align: center;
  padding: 26rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
}

.btn-cancel {
  background: #fff;
  color: #8B7E72;
  border: 2rpx solid #E8DCCB;
}

.btn-save {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  font-weight: 500;
  letter-spacing: 4rpx;
}
