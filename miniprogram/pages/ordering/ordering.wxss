.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5EFE6;
}

.header {
  background: #fff;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #E8DCCB;
}

.t-name {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.t-mode {
  font-size: 24rpx;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.t-mode.new { color: #5B7C42; }
.t-mode.append { color: #A0341A; }

.empty {
  flex: 1;
  text-align: center;
  padding: 200rpx 0;
  color: #8B7E72;
}

.content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.cat-bar {
  width: 160rpx;
  background: rgba(160,52,26,0.06);
  height: 100%;
}

.cat {
  padding: 28rpx 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8B7E72;
  border-left: 6rpx solid transparent;
}

.cat.active {
  background: #F5EFE6;
  color: #A0341A;
  font-weight: 500;
  border-left-color: #A0341A;
}

.dish-scroll {
  flex: 1;
  height: 100%;
}

.dish-grid {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  align-content: start;
}

.dish-btn {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 16rpx;
  text-align: center;
  border: 2rpx solid #E8DCCB;
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(160,52,26,0.04);
  position: relative;
}

.dish-btn::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  right: 12rpx;
  bottom: 12rpx;
  border: 1rpx dashed rgba(160,52,26,0.15);
  border-radius: 14rpx;
  pointer-events: none;
}

.d-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #2A1F1A;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.d-price {
  font-size: 28rpx;
  color: #A0341A;
  font-weight: 500;
}

.bottom-bar {
  display: flex;
  align-items: center;
  background: #2A1F1A;
  color: #fff;
  padding: 18rpx 24rpx;
  gap: 16rpx;
}

.cart-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-top: -32rpx;
  box-shadow: 0 4rpx 14rpx rgba(160,52,26,0.4);
  position: relative;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #fff;
  color: #A0341A;
  font-size: 22rpx;
  font-weight: 500;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}

.amt-area {
  flex: 1;
}

.amt-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.amt-val {
  font-size: 36rpx;
  font-weight: 500;
  color: #F5D58C;
  letter-spacing: 1rpx;
}

.btn-submit {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.btn-submit.disabled {
  background: #555;
  opacity: 0.7;
}

/* 弹层 */
.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(42,31,26,0.65);
}

.sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FAF6EE;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx;
  max-height: 88vh;
  overflow-y: auto;
}

.sheet::before {
  content: '';
  display: block;
  width: 80rpx;
  height: 6rpx;
  background: #E8DCCB;
  border-radius: 3rpx;
  margin: 0 auto 24rpx;
}

/* 配料弹层 */
.addon-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #E8DCCB;
  margin-bottom: 24rpx;
}

.addon-name {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: #2A1F1A;
}

.addon-price {
  font-size: 32rpx;
  color: #A0341A;
  font-weight: 500;
}

.section {
  margin-bottom: 28rpx;
}

.sec-title {
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #8B7E72;
  letter-spacing: 2rpx;
  position: relative;
  padding-left: 16rpx;
}

.sec-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 22rpx;
  background: #A0341A;
  border-radius: 2rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-chip {
  background: #fff;
  color: #5C4D40;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #E8DCCB;
  line-height: 1;
}

.tag-chip.active {
  background: #A0341A;
  color: #fff;
  border-color: #A0341A;
  font-weight: 500;
}

.custom-input {
  background: #fff;
  border: 2rpx solid #E8DCCB;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.addon-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-cancel {
  flex: 1;
  background: #fff;
  color: #8B7E72;
  border: 2rpx solid #E8DCCB;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-confirm {
  flex: 2;
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 购物车弹层 */
.sheet-title {
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 4rpx;
}

.cart-list {
  margin-bottom: 24rpx;
}

.cart-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #E8DCCB;
}

.c-info {
  flex: 1;
}

.c-name {
  font-size: 30rpx;
  font-weight: 500;
}

.c-extra {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.c-addon {
  background: #FBF1E2;
  color: #C28952;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.c-note {
  background: #F8E5DD;
  color: #A0341A;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.c-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.btn-sub {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #A0341A;
  background: #fff;
  color: #A0341A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.btn-add {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #A0341A;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.c-count {
  min-width: 40rpx;
  text-align: center;
  font-weight: 500;
}

.cart-foot {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #E8DCCB;
}

.cart-foot > view:first-child {
  flex: 1;
  font-size: 26rpx;
  color: #8B7E72;
}

.t-price {
  color: #A0341A;
  font-size: 40rpx;
  font-weight: 500;
  margin-left: 8rpx;
}
