.page {
  padding: 32rpx 24rpx 48rpx;
  min-height: 100vh;
  background: #F5EFE6;
}

.check-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #5B7C42;
  color: #fff;
  font-size: 56rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(91,124,66,0.3);
}

.success-text {
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  margin-bottom: 32rpx;
  color: #2A1F1A;
}

.ticket-paper {
  background: #fff;
  padding: 40rpx 36rpx 48rpx;
  margin: 0 0 36rpx;
  position: relative;
  box-shadow: 0 6rpx 24rpx rgba(160,52,26,0.1);
  font-family: "PingFang SC", "Source Han Sans", monospace;
}

.ticket-paper::before,
.ticket-paper::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  height: 16rpx;
  background-image: linear-gradient(45deg, transparent 33%, #F5EFE6 33%, #F5EFE6 66%, transparent 66%),
                    linear-gradient(-45deg, transparent 33%, #F5EFE6 33%, #F5EFE6 66%, transparent 66%);
  background-size: 32rpx 16rpx;
}

.ticket-paper::before { top: -16rpx; }
.ticket-paper::after { bottom: -16rpx; }

.paper-head {
  text-align: center;
  margin-bottom: 20rpx;
}

.shop-name {
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: #2A1F1A;
}

.shop-sub {
  font-size: 22rpx;
  color: #8B7E72;
  margin-top: 6rpx;
  letter-spacing: 4rpx;
}

.divider {
  border-top: 2rpx dashed #2A1F1A;
  margin: 20rpx 0;
}

.divider.double {
  border-top: 4rpx double #2A1F1A;
}

.number-area {
  text-align: center;
  padding: 16rpx 0;
}

.num-label {
  font-size: 22rpx;
  color: #8B7E72;
  letter-spacing: 4rpx;
}

.number {
  font-size: 120rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #A0341A;
  letter-spacing: 4rpx;
  margin: 8rpx 0;
}

.table {
  font-size: 32rpx;
  font-weight: 500;
  color: #2A1F1A;
  letter-spacing: 2rpx;
}

.dish-list {
  font-size: 28rpx;
}

.dish-row {
  margin-bottom: 20rpx;
}

.d-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 36rpx;
  font-weight: 500;
  color: #2A1F1A;
  letter-spacing: 2rpx;
}

.d-name {
  flex: 1;
}

.d-count {
  font-weight: 700;
  font-size: 32rpx;
}

.d-extra {
  padding-left: 24rpx;
  margin-top: 6rpx;
}

.extra-line {
  font-size: 26rpx;
  line-height: 1.7;
}

.extra-line.addon {
  color: #C28952;
}

.extra-line.note {
  color: #A0341A;
  font-weight: 500;
}

.paper-foot {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8B7E72;
}

.amount {
  font-weight: 500;
  color: #2A1F1A;
}

.thanks {
  text-align: center;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8B7E72;
  letter-spacing: 4rpx;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.btn-pri,
.btn-out,
.btn-line {
  flex: 1;
  text-align: center;
  padding: 26rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-pri {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 14rpx rgba(160,52,26,0.3);
}

.btn-out {
  background: #FBF1E2;
  color: #A0341A;
  border: 2rpx solid #C28952;
}

.btn-line {
  background: #fff;
  color: #8B7E72;
  border: 2rpx solid #E8DCCB;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #B5A99B;
  letter-spacing: 2rpx;
}
