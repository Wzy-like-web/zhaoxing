.page {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(160,52,26,0.05);
}

.connected {
  background: linear-gradient(135deg, #5B7C42 0%, #3F5B2C 100%);
  color: #fff;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
}

.connected-info { flex: 1; }
.ci-label { font-size: 22rpx; opacity: 0.85; letter-spacing: 2rpx; }
.ci-name { font-size: 32rpx; font-weight: 500; margin-top: 4rpx; }

.actions-block {
  margin-bottom: 20rpx;
}

.empty-state {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.big-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #8B7E72;
  line-height: 1.6;
}

.btn-pri {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  text-align: center;
  padding: 26rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(160,52,26,0.2);
}

.btn-pri.scanning {
  background: #8B7E72;
}

.btn-line {
  background: #fff;
  color: #8B7E72;
  border: 2rpx dashed #E8DCCB;
  text-align: center;
  padding: 24rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 16rpx;
  color: #2A1F1A;
  letter-spacing: 2rpx;
  position: relative;
  padding-left: 16rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 22rpx;
  background: #A0341A;
  border-radius: 2rpx;
}

.scanning-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 0;
  color: #8B7E72;
  font-size: 26rpx;
}

.dot-loader {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #A0341A;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(1.4); }
}

.device-list {
  border-top: 1rpx solid #F5EFE6;
}

.device-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5EFE6;
}

.device-row:last-child { border-bottom: none; }

.device-row.connecting {
  opacity: 0.6;
}

.dev-info {
  flex: 1;
  min-width: 0;
}

.dev-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2A1F1A;
}

.dev-id {
  font-size: 20rpx;
  color: #B5A99B;
  margin-top: 4rpx;
  word-break: break-all;
}

.dev-rssi {
  font-size: 20rpx;
  color: #8B7E72;
}

.dev-arrow {
  color: #A0341A;
  font-size: 28rpx;
  font-weight: 500;
}

.hint-box {
  background: #FBF1E2;
  border: 1rpx dashed #E8DCCB;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.hint-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #A0341A;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.hint-line {
  font-size: 24rpx;
  color: #5C4D40;
  line-height: 1.8;
}

.hint-line.ios-warn {
  color: #A0341A;
  font-weight: 500;
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx dashed rgba(160,52,26,0.2);
}
