.page {
  padding: 24rpx;
}

.range-tabs {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(160,52,26,0.04);
}

.r-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  border-radius: 10rpx;
  color: #8B7E72;
  letter-spacing: 2rpx;
}

.r-tab.active {
  background: linear-gradient(135deg, #C28952 0%, #A0341A 100%);
  color: #fff;
  font-weight: 500;
}

.hero {
  background: linear-gradient(135deg, #A0341A 0%, #7A2614 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 56rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
  top: -80rpx;
  right: -60rpx;
}

.hero-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
}

.hero-value {
  font-size: 80rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.kpi-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 26rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(160,52,26,0.04);
}

.kpi-label {
  font-size: 24rpx;
  color: #8B7E72;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}

.kpi-value {
  font-size: 44rpx;
  font-weight: 500;
  color: #2A1F1A;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(160,52,26,0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 20rpx;
  color: #2A1F1A;
  letter-spacing: 2rpx;
  position: relative;
  padding-left: 16rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 22rpx;
  background: #A0341A;
  border-radius: 2rpx;
}

.empty-mini {
  text-align: center;
  padding: 40rpx 0;
  color: #8B7E72;
  font-size: 24rpx;
}

.pay-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.p-label {
  width: 100rpx;
  font-size: 26rpx;
  color: #5C4D40;
}

.p-bar {
  flex: 1;
  height: 16rpx;
  background: #F5EFE6;
  border-radius: 8rpx;
  overflow: hidden;
}

.p-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C28952 0%, #A0341A 100%);
  border-radius: 8rpx;
  transition: width 0.4s;
}

.p-value {
  width: 140rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: #A0341A;
}

.top-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5EFE6;
}

.top-row:last-child {
  border-bottom: none;
}

.rank {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F5EFE6;
  color: #8B7E72;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
  font-size: 26rpx;
}

.rank-1 { background: linear-gradient(135deg, #FFD777 0%, #C28952 100%); color: #fff; }
.rank-2 { background: linear-gradient(135deg, #D6D2C9 0%, #B5A99B 100%); color: #fff; }
.rank-3 { background: linear-gradient(135deg, #C28952 0%, #8E5E35 100%); color: #fff; }

.t-name {
  flex: 1;
  font-size: 28rpx;
}

.t-count {
  font-size: 24rpx;
  color: #8B7E72;
  margin-right: 16rpx;
}

.t-rev {
  font-size: 28rpx;
  color: #A0341A;
  font-weight: 500;
}
